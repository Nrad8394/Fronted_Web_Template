# =============================================================================
# Frontend environment
#
#   cp .env.example .env.local
#
# .env.local is gitignored and is what `next dev` reads.
#
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ means PUBLIC
# ---------------------------------------------------------------------------
# Any variable with this prefix is inlined into the JavaScript bundle and
# served to every visitor. It is not hidden, not obfuscated, and not
# protected by anything. Never put an API secret, a private key, or a
# database URL behind this prefix — treat it as if you had published it in
# the page source, because you have.
#
# Server-only values (no prefix) are readable in Server Components, Route
# Handlers, and middleware. Those stay on the server.
#
# ---------------------------------------------------------------------------
# Build time vs runtime
# ---------------------------------------------------------------------------
# Next.js bakes NEXT_PUBLIC_* into the bundle at build time. In Docker, the
# entrypoint overrides them at container start via window.__ENV__ — so one
# image works in every environment. See lib/env.ts. In `next dev` there is no
# container, so the values below are used directly.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Absolute URL, or a same-origin path when a reverse proxy fronts both the
# app and the API.
#
# Same-origin (`/api`) is worth preferring in production: no CORS preflight on
# every request, and no third-party-cookie restrictions to work around. Use an
# absolute URL when the API is genuinely on another host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=App
# development | staging | production — for feature flags and telemetry tags.
NEXT_PUBLIC_APP_ENV=development
# Used as metadataBase, so relative Open Graph image paths resolve correctly.
# Wrong here means broken social previews in production and nowhere else.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser)
# -----------------------------------------------------------------------------
# API host for server-side fetches. Inside Docker this is usually a service
# name the browser cannot resolve, which is exactly why it is separate from
# NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Send Strict-Transport-Security. Leave false until every subdomain is
# HTTPS-only: browsers cache HSTS for the full max-age and will refuse plain
# HTTP to your domain until it expires. It is not revocable from the server.
ENABLE_HSTS=false
